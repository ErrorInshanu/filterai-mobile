{
  "expo": {
    "name": "FILTERAI-mobile",
    "slug": "FILTERAI-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "filteraimobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "experiments": {
      "reactCompiler": true
    }
  }
}